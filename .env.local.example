# Supabase — copy this file to `.env.local` and fill in your own values.
#
# Find both under Project Settings → API in the Supabase dashboard.
# Use the *anon / public* key, never the service_role key: anything
# prefixed NEXT_PUBLIC_ is shipped to the browser. Row level security
# (supabase/schema.sql) is what protects the data.
#
# `.env.local` is git-ignored, so your keys stay out of the repo.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number that receives order handoffs (digits only, country code
# first, no + or spaces). Example for Indonesia: 6281234567890
NEXT_PUBLIC_WA_KASIR=6281234567890

# Optional anti-bot: Cloudflare Turnstile *site* key (safe to expose). Leave
# blank to keep the login form open with no captcha. If you set this, also
# paste the matching *secret* key into Supabase → Authentication → Attack
# Protection → enable Captcha (Turnstile). Set one without the other and email
# login breaks — see SETUP.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
